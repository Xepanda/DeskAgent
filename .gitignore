# Desk Agent R1 .gitignore

# 凭据、密钥与私密数据 (Secrets & Credentials)
*.pem
*.key
*.pfx
*.pkcs12
*.crt
id_rsa*
secrets.*
credentials.*
# Local device authorization injected at build time; never commit real values.
firmware/main/include/tuya_config_secrets.h
**/tuya_config_secrets.h
**/tuya_app_config_secrets.h
*.token
*.auth

# 环境变量文件 (Environment Variables)
.env
.env.*
!.env.example

# 日志文件 (Logs)
*.log
logs/
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Python 缓存与虚拟环境 (Python Cache & Virtual Environments)
__pycache__/
*.py[cod]
*$py.class
*.so
*.db
*.db-wal
*.db-shm
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
venv/
.venv/
env/
ENV/

# Node.js 缓存与依赖
node_modules/
.npm/
.pnpm-store/

# 固件构建与 C/C++ 嵌入式构建产物 (Firmware & Build Artifacts)
.build/
.target_logging/
# Windows local project alias; canonical source is firmware/.
source/embedded/
build/
dist/
out/
bin/
obj/
*.egg-info/
.pio/
.espressif/
firmware/managed_components/
sdkconfig.old
*.bin
*.elf
*.map

# 操作系统与编辑器临时文件
.DS_Store
Thumbs.db
desktop.ini
~$*.docx
~$*.doc
.vscode/*
!.vscode/settings.json.example
.idea/
*.swp
*.swo
*~

# 显式保留重要文档资产 (Preserve Documentation Assets)
!*.docx
!docs/**/*.docx
!*.md
!docs/**/*.md

# Machine-generated ESP-IDF configuration; canonical inputs are committed.
firmware/sdkconfig
# Device backups stay local, even if a future format lacks a .bin suffix.
backups/

# 显式保留已构建的目标固件发布产物 (Track Compiled Firmware Dist Artifacts)
!firmware/dist/
!firmware/dist/**
