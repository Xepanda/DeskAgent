/* Copy to tuya_config_secrets.h locally; that file is ignored by Git.
 * Use the same authorized device identity when updating an already-bound unit.
 * Never commit real values or reset a bound device to run a build. */
#define TUYA_OPENSDK_UUID "REPLACE_WITH_AUTHORIZED_DEVICE_UUID"
#define TUYA_OPENSDK_AUTHKEY "REPLACE_WITH_AUTHORIZED_DEVICE_AUTHKEY"
