CONFIG_PROJECT_NAME="desk_agent_firmware"
CONFIG_BOARD_CHOICE_ESP32=y
CONFIG_BOARD_CHOICE_ESP32_S3=y
CONFIG_PLATFORM_FLASHSIZE_32M=y
CONFIG_BOARD_CONFIG=y
CONFIG_ENABLE_EXT_RAM=y
CONFIG_UART_NUM0_TX_PIN=43
CONFIG_UART_NUM0_RX_PIN=44
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_DESK_BOARD_SENSECAP_WATCHER=y
CONFIG_TCLAW_USE_AI_COMPONENTS=y
CONFIG_TCLAW_USE_EXT_RAM=y
CONFIG_ENABLE_AUDIO_CODECS=y
CONFIG_AUDIO_CODEC_NAME="watcher_audio"
# The native SPD2010 adapter owns the panel; do not start a second LVGL UI.
# CONFIG_ENABLE_COMP_AI_DISPLAY is not set
CONFIG_CODEC_I2C_BACKWARD_COMPATIBLE=y
# Keep T5-specific hardware tools and optional Lua disabled for Watcher.
# CONFIG_ENABLE_HARDWARE_MCP is not set
# CONFIG_ENABLE_LUA_TOOL is not set

